-- 5 MAIN FUNCTIONS LOGIC
----------------------------------------------------

-- 1. Auto Parry (คำนวณระยะทางและความเร็วลูกบอลอัตโนมัติ)
RunService.PreRender:Connect(function()
    if not Config.AutoParry then return end
    
    local ball = GetBall()
    if not ball then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local ballPosition = ball.Position
    local ballVelocity = ball.AssemblyLinearVelocity
    local distance = (hrp.Position - ballPosition).Magnitude
    
    -- เช็คว่าลูกบอลกำลังพุ่งมาหาเราหรือไม่
    local dotProduct = (hrp.Position - ballPosition).Unit:Dot(ballVelocity.Unit)
    
    -- ปรับระยะตีตามความเร็วลูกบอล (Dynamic Distance)
    local dynamicDistance = Config.ParryDistance + (ballVelocity.Magnitude * 0.1)
    
    if distance <= dynamicDistance and dotProduct > 0.3 then
        TriggerParry()
    end
end)

-- 2. Spam Parry (สแปมบล็อกระยะประชิดเมื่อเข้าสู่ภาวะดวล 1v1)
task.spawn(function()
    while task.wait(0.02) do
        if Config.SpamParry then
            local ball = GetBall()
            if ball then
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local dist = (character.HumanoidRootPart.Position - ball.Position).Magnitude
                    if dist <= 15 then -- ระยะประชิด
                        TriggerParry()
                    end
                end
            end
        end
    end
end)

-- 3. Target Aimbot (หันหน้าใส่คนดวลทันทีที่บล็อกบอล)
RunService.RenderStepped:Connect(function()
    if not Config.TargetAimbot then return end
    
    local ball = GetBall()
    if not ball then return end
    
    -- ล็อคเป้าหมายไปที่คนที่บอลกำลังพุ่งไปหา หรือผู้เล่นที่ใกล้ที่สุด
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local targetPlayer = nil
        local closestDist = math.huge
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local d = (character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if d < closestDist then
                    closestDist = d
                    targetPlayer = p
                end
            end
        end
        
        if targetPlayer and targetPlayer.Character then
            local targetPos = targetPlayer.Character.HumanoidRootPart.Position
            character.HumanoidRootPart.CFrame = CFrame.new(character.HumanoidRootPart.Position, Vector3.new(targetPos.X, character.HumanoidRootPart.Position.Y, targetPos.Z))
        end
    end
end)

-- 4. Auto Use Ability (กดใช้สกิลใส่ออโต้เมื่อบอลเข้าใกล้)
task.spawn(function()
    while task.wait(0.1) do
        if Config.AutoAbility then
            local ball = GetBall()
            if ball then
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local dist = (character.HumanoidRootPart.Position - ball.Position).Magnitude
                    if dist <= Config.ParryDistance + 5 then
                        -- กดปุ่ม Q เพื่อใช้ Ability
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                    end
                end
            end
        end
    end
end)

-- 5. FPS Booster & Anti-Lag (ลบเอฟเฟกต์/เงา เพิ่มความลื่นเพื่อการบล็อกที่แม่นยำ)
local function ToggleFPSBooster(enable)
    local Lighting = game:GetService("Lighting")
    if enable then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            end
        end
    end
end

